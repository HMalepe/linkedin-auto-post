# Public URL of the deployed app (no trailing slash). Used for the LinkedIn OAuth redirect.
APP_URL=http://localhost:3000

# Password for the dashboard (HTTP Basic auth, any username).
ADMIN_PASSWORD=change-me

# Secret for /api/cron/publish. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=long-random-string

# Supabase (server-side only: never expose the service role key to the browser)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LinkedIn developer app (https://www.linkedin.com/developers/apps)
# Products to enable: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Redirect URL to register: ${APP_URL}/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn API versions expire after ~12 months; bump when LinkedIn retires this one.
LINKEDIN_VERSION=202509

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
