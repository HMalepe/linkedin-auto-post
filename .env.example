# Public URL of the deployed app (no trailing slash). Used for the LinkedIn OAuth redirect.
APP_URL=http://localhost:3000

# Password for the dashboard (HTTP Basic auth, any username). Use something long.
ADMIN_PASSWORD=change-me

# Secret for /api/cron/publish. Vercel Cron sends it automatically as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET=long-random-string

# Supabase (server-side only: never expose the service role key to the browser)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LinkedIn developer app (https://www.linkedin.com/developers/apps)
# Products to enable: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Redirect URL to register: ${APP_URL}/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn REST API version (YYYYMM). Each version is retired ~12 months after release
# (requests then fail with 426). The dashboard's setup checklist warns at 10 months.
LINKEDIN_VERSION=202608

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
